# Render Web Service Environment Variables
# One KEY=value per line, no quotes, no inline comments

# Server and Spring Profile
SPRING_PROFILES_ACTIVE=prod
PORT=10000

# Public URLs (Never include trailing slashes)
APP_PUBLIC_URL=https://REPLACE-WITH-VERCEL-URL
API_PUBLIC_URL=https://REPLACE-WITH-RENDER-HOST.onrender.com

# Database Connection (Render Managed PostgreSQL)
DB_HOST=REPLACE_ME
DB_PORT=5432
DB_NAME=REPLACE_ME
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME
DB_POOL_SIZE=10

# Resource Protection & Concurrency Bulkheads
RATE_LIMIT_UNAUTH_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=600
AI_MAX_CONCURRENT=6
STT_MAX_CONCURRENT=3
HEAVY_PARSE_MAX_CONCURRENT=2
BULKHEAD_ACQUIRE_TIMEOUT_MS=5000
PDF_MAX_PAGES=80
PPTX_MAX_SLIDES=60

# Cookies and Security
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
SESSION_TIMEOUT=8h

# Real-Time Events & SSE Streaming Engine
# Maximum concurrent SSE streams allowed per user across tabs/devices
SSE_MAX_STREAMS_PER_USER=6
# Event bus implementation: 'local' (single container) or 'postgres' (multi-instance cluster via LISTEN/NOTIFY)
EVENTS_BUS=postgres

# Object Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=bracket-uploads
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_PATH_STYLE=false

# AES-256-GCM Token Encryption Key (32 random bytes, base64 or 64 hex characters)
APP_ENCRYPTION_KEY=REPLACE_ME

# OAuth2 Authentication - GitHub
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME

# OAuth2 Authentication - Google
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME

# GitHub Repository Syncing Integration
# GitHub OAuth link callback: https://<VERCEL-APP-DOMAIN>/api/v1/github/link/callback
APP_GITHUB_TOKEN=REPLACE_ME
APP_GITHUB_USE_FAKE=false
GITHUB_LINK_CLIENT_ID=REPLACE_ME
GITHUB_LINK_CLIENT_SECRET=REPLACE_ME

# Canva Integration
# Canva developer console redirect URL: https://<VERCEL-APP-DOMAIN>/api/v1/integrations/canva/callback
CANVA_CLIENT_ID=REPLACE_ME
CANVA_CLIENT_SECRET=REPLACE_ME

# AI Gateway Configuration (Groq / BYOK OpenAI-compatible)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=REPLACE_ME
AI_MODEL_DEFAULT=llama-3.3-70b-versatile
AI_MODEL_FAST=llama-3.1-8b-instant
AI_MODEL_SMART=llama-3.3-70b-versatile
AI_PLATFORM_FALLBACK=false

# Speech-to-Text Whisper Gateway
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=REPLACE_ME
STT_MODEL=whisper-large-v3

# Mail Configuration (Gmail SMTP)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_APP_PASSWORD=REPLACE_ME
MAIL_FROM_ADDRESS=REPLACE_ME
MAIL_FROM_NAME=Hackathon OS
MAIL_REPLY_TO=REPLACE_ME

# Administrative and Support Contacts
ADMIN_EMAILS=REPLACE_ME
SUPPORT_EMAIL=REPLACE_ME

# Observability & Proxy Security
PROXY_SHARED_SECRET=
METRICS_TOKEN=REPLACE_ME
SENTRY_DSN=
VITE_SENTRY_DSN=

# Mail Provider ('smtp', 'resend', or 'log')
MAIL_PROVIDER=smtp
RESEND_API_KEY=
