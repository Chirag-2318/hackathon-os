# ==============================================================================
# HACKATHON OS - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# --- Spring & Server Profiles ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database Credentials & Connectivity ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/hackathon_os?options=-c%20TimeZone=UTC
SPRING_DATASOURCE_USERNAME=hackathon
SPRING_DATASOURCE_PASSWORD=hackathon

# --- Application Encryption Key ---
# Used for encrypting OAuth access tokens and sensitive integrations at rest.
# Generate a 32-byte key via terminal: openssl rand -hex 32
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Security, Session & CORS ---
# In production, set COOKIE_SECURE=true to enforce HTTPS-only cookies
COOKIE_SECURE=false
# Comma-separated list of allowed origin URLs for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:8080

# --- File Storage & Uploads ---
# Local directory for user avatars, brief PDFs, and generated pitch assets.
# Note: Ensure the directory exists with write permissions: mkdir -p uploads && chmod 755 uploads
APP_UPLOAD_DIR=./uploads

# --- OAuth2 Authentication Providers ---
# GitHub OAuth App: callback is http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=dummy-github-client-id
GITHUB_CLIENT_SECRET=dummy-github-client-secret

# Google OAuth App: callback is http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# --- Optional Integrations ---
APP_GITHUB_TOKEN=
APP_GITHUB_USE_FAKE=false
GITHUB_LINK_CLIENT_ID=
GITHUB_LINK_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# --- Unified AI Gateway (Bring Your Own Key - BYOK: Groq) ---
# Base URL for chat completions endpoint (must end without trailing slash)
AI_BASE_URL=https://api.groq.com/openai/v1
# In production, users provide their own Groq API keys via Settings > AI.
# The server pays for zero AI usage.
# AI_PLATFORM_FALLBACK and AI_PLATFORM_KEY are strictly for local 'dev' profile development.
AI_PLATFORM_FALLBACK=false
AI_PLATFORM_KEY=
# Default primary model
AI_MODEL_DEFAULT=llama-3.3-70b-versatile
# Fast/cheaper model for lightweight features (name suggestion, brief keyword extraction)
AI_MODEL_FAST=llama-3.1-8b-instant
# Smart model for complex creative tasks (pitch script, judge counter-questions)
AI_MODEL_SMART=llama-3.3-70b-versatile

# Whether the provider supports response_format: {"type": "json_object"}
AI_JSON_MODE_SUPPORTED=true
# Request timeout in seconds
AI_TIMEOUT_SECONDS=45
# Maximum retry attempts with backoff and jitter on 429/5xx/timeout
AI_MAX_RETRIES=2
# Maximum concurrent in-flight requests to the LLM provider
AI_MAX_CONCURRENCY=4
# Rate limit per user per minute
AI_USER_RATE_PER_MINUTE=10
# Master kill-switch flag for AI features
AI_ENABLED=true

# --- Speech-to-Text (STT) for Pitch Rehearsal (Whisper) ---
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3

# --- Billing & Entitlements ---
# Set to true to enforce room limits and MAX plan requirements for Review, Retro and Summary pages
BILLING_ENFORCE=false
# Default plan assigned to new users when no explicit plan row exists (FREE, PRO, or MAX)
BILLING_DEFAULT_PLAN=FREE

# --- Mail Service (Gmail SMTP) ---
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=Bracket
APP_PUBLIC_URL=http://localhost:5173
APP_MAIL_TEST_ENDPOINT_ENABLED=false
