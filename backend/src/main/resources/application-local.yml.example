# Example local configuration overrides for Hackathon OS backend
# Copy to application-local.yml and populate with your own local credentials.
# application-local.yml is ignored by git and never committed.

spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/hackathon_os?options=-c%20TimeZone=UTC
    username: hackathon
    password: hackathon
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        format_sql: true
    show-sql: true
  security:
    oauth2:
      client:
        registration:
          github:
            client-id: your_local_github_client_id
            client-secret: your_local_github_client_secret
          google:
            client-id: your_local_google_client_id
            client-secret: your_local_google_client_secret

app:
  encryption-key: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
