# ==============================================================================
# [brackit] - Production Environment Configuration Template
# ==============================================================================
# Copy this file to backend.env and replace placeholder values with actual secrets.
#   cp deploy/backend.env.example deploy/backend.env
#   chmod 600 deploy/backend.env

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Generate strong database password using: openssl rand -base64 24
POSTGRES_DB=hackathon_os
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=generate_with_openssl_rand_base64_24

# ------------------------------------------------------------------------------
# 2. ENCRYPTION KEY
# ------------------------------------------------------------------------------
# 256-bit AES key used to encrypt OAuth tokens & external provider keys at rest.
# Generate using: openssl rand -hex 32
APP_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 3. OAUTH PROVIDERS
# ------------------------------------------------------------------------------
# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google Cloud OAuth Client: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 4. DEPLOYMENT MODE & PUBLIC URLS (Select Mode A or Mode B)
# ------------------------------------------------------------------------------
# MODE A (Recommended): Custom domain with subdomains.
# - Frontend: https://app.example.com
# - Backend:  https://api.example.com
# - COOKIE_DOMAIN=.example.com allows browser to send session & CSRF cookies across subdomains.
API_HOST=api.example.com
APP_PUBLIC_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
COOKIE_DOMAIN=.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# MODE B (Alternative - Single Origin via Vercel Proxied Rewrites):
# - Frontend proxies /api, /oauth2, /login/oauth2, and /uploads to the VM via Vercel rewrites.
# - Uncomment these and comment out the Mode A settings above:
# API_HOST=api-vm.example.com
# APP_PUBLIC_URL=https://your-app.vercel.app
# API_PUBLIC_URL=https://your-app.vercel.app
# COOKIE_DOMAIN=
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ------------------------------------------------------------------------------
# 5. TRUSTED CLIENT IP HEADER
# ------------------------------------------------------------------------------
# In Mode B (or when Vercel is proxying requests), Vercel passes client IP in:
# x-vercel-forwarded-for. Behind standard reverse proxies (Caddy/Nginx), use x-forwarded-for.
CLIENT_IP_HEADER=x-vercel-forwarded-for

# ------------------------------------------------------------------------------
# 6. MAIL CONFIGURATION (Gmail SMTP)
# ------------------------------------------------------------------------------
# In Gmail: Enable 2-Step Verification -> Create an App Password at:
# https://myaccount.google.com/apppasswords
# Paste the 16-character code below without spaces.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@example.com
MAIL_APP_PASSWORD=your_16_char_gmail_app_password
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME="[brackit]"
MAIL_REPLY_TO=support@example.com
MAIL_DAILY_LIMIT=400
MAIL_DRY_RUN=false

# ------------------------------------------------------------------------------
# 7. ADMINISTRATOR AND CAPACITY CONTROLS
# ------------------------------------------------------------------------------
# Comma-separated list of admin email addresses (exempt from cap & grants admin overview access)
ADMIN_EMAILS=admin@example.com,founder@example.com
SUPPORT_EMAIL=support@example.com

# Maximum total registered users allowed (0 = unlimited)
APP_USER_CAP=1000
APP_MAX_ROOMS_PER_USER=10
APP_MAX_UPLOAD_MB_PER_USER=50

# ------------------------------------------------------------------------------
# 8. AI PLATFORM SAFETY
# ------------------------------------------------------------------------------
# MUST be false in production! Users bring their own AI keys; platform pays for NO AI usage.
# Server startup will fail if this is set to true under prod profile.
AI_PLATFORM_FALLBACK=false
