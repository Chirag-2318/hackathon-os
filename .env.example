# Database configuration
POSTGRES_DB=hackathon_os
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon_secure_password
DB_HOST=localhost
DB_PORT=5432

# Backend application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# GitHub OAuth2 Configuration
# Register callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth2 Configuration
# Register callback URL: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend Application
# In development: http://localhost:5173
# In docker production: http://localhost (via Nginx reverse proxy)
VITE_API_BASE_URL=http://localhost:8080

# GitHub Connect & Account Linking
# Server token for fetching public/organization repositories
APP_GITHUB_TOKEN=
# Separate OAuth App for account linking (Callback URL: http://localhost:8080/api/v1/github/link/callback)
GITHUB_LINK_CLIENT_ID=
GITHUB_LINK_CLIENT_SECRET=

# Canva Connect Integration (Callback URL: http://localhost:8080/api/v1/integrations/canva/callback)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# AI Configuration (Groq / OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_TOKENS=6000

# Optional alias compatibility (xAI)
XAI_API_KEY=
XAI_MODEL=
XAI_VISION_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MAX_TOKENS=6000
