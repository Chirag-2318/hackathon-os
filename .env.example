# Database configuration
POSTGRES_DB=hackathon_os
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon_secure_password
DB_HOST=localhost
DB_PORT=5432

# Backend application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Application Encryption Key (32 bytes / 64 hex characters: openssl rand -hex 32)
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Resource Protection & Concurrency Bulkheads
DB_POOL_SIZE=10
AI_MAX_CONCURRENT=6
STT_MAX_CONCURRENT=3
HEAVY_PARSE_MAX_CONCURRENT=2
BULKHEAD_ACQUIRE_TIMEOUT_MS=5000
PDF_MAX_PAGES=80
PPTX_MAX_SLIDES=60

# Security & CORS
RATE_LIMIT_UNAUTH_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=600
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:8080
# Sliding inactivity timeout for Spring Session (e.g. 8h, 30m)
SESSION_TIMEOUT=8h

# Real-time Events & SSE Broadcast Engine
# Maximum concurrent SSE streams allowed per user across tabs/devices
SSE_MAX_STREAMS_PER_USER=6
# Event bus implementation: 'local' (single container) or 'postgres' (multi-instance cluster via LISTEN/NOTIFY)
EVENTS_BUS=local

# File Uploads Directory (Ensure write permissions: mkdir -p uploads && chmod 755 uploads)
# Provider: 'local' (ephemeral/local disk) or 's3' (S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local
APP_UPLOAD_DIR=./uploads
# S3 / Object Storage configuration (required when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false

# GitHub OAuth2 Configuration
# Register callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth2 Configuration
# Register callback URL: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional Integrations
# GitHub OAuth App Link callback: https://<VERCEL-APP-DOMAIN>/api/v1/github/link/callback (or http://localhost:8080/api/v1/github/link/callback in dev)
# Canva integration callback: https://<VERCEL-APP-DOMAIN>/api/v1/integrations/canva/callback (or http://localhost:8080/api/v1/integrations/canva/callback in dev)
APP_GITHUB_TOKEN=
APP_GITHUB_USE_FAKE=false
GITHUB_LINK_CLIENT_ID=
GITHUB_LINK_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Unified AI Gateway (Bring Your Own Key - BYOK: Groq)
AI_BASE_URL=https://api.groq.com/openai/v1
# In production, users provide their own Groq API keys via Settings > AI.
# The server pays for zero AI usage.
# AI_PLATFORM_FALLBACK and AI_PLATFORM_KEY are strictly for local 'dev' profile development.
AI_PLATFORM_FALLBACK=false
AI_PLATFORM_KEY=
AI_MODEL_DEFAULT=llama-3.3-70b-versatile
AI_MODEL_FAST=llama-3.1-8b-instant
AI_MODEL_SMART=llama-3.3-70b-versatile

AI_JSON_MODE_SUPPORTED=true
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_MAX_CONCURRENCY=4
AI_USER_RATE_PER_MINUTE=10
AI_ENABLED=true

# Speech-to-Text (STT) for Pitch Rehearsal (Whisper)
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3

# Frontend Application
# In development: http://localhost:5173
# In docker production: http://localhost (via Nginx reverse proxy)
VITE_API_BASE_URL=http://localhost:8080

# Mail Configuration (Gmail SMTP)
# Note: Gmail requires a dedicated 16-character App Password, not the Google account password.
# Keep 2-Step Verification enabled, generate an App Password in Google Account settings,
# and enter the 16 characters without spaces.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_APP_PASSWORD=abcdefghijklmnop
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Hackathon OS
MAIL_REPLY_TO=
MAIL_DAILY_LIMIT=400
MAIL_DRY_RUN=false
APP_PUBLIC_URL=http://localhost:5173
APP_MAIL_TEST_ENDPOINT_ENABLED=false

# Observability & Proxy Security
PROXY_SHARED_SECRET=
METRICS_TOKEN=
SENTRY_DSN=
VITE_SENTRY_DSN=

# Mail Provider ('smtp', 'resend', or 'log')
MAIL_PROVIDER=smtp
RESEND_API_KEY=
